# Unity YAML files as text so scenes/prefabs are diffable/mergeable where possible.
*.cs text diff=csharp
*.unity text
*.prefab text
*.asset text
*.mat text
*.anim text
*.controller text
*.meta text

# Git LFS for binary art + audio + video
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
